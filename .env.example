PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=digilibrary

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Borrowing rule: block new issues if member has unpaid fines above this amount
MAX_UNPAID_FINE=0

# Used only by `npm run seed` to create the very first admin
BOOTSTRAP_ADMIN_NAME=Library Admin
BOOTSTRAP_ADMIN_EMAIL=admin@college.edu
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@123
